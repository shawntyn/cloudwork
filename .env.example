# Local development defaults. Replace all four secrets before allowing remote users.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local-auth-change-this-7b9918d73d827722b6e69972
POSTGRES_PASSWORD=local-postgres-change-this
REDIS_PASSWORD=local-redis-change-this
MANAGER_TOKEN=local-manager-change-this-4ccbc38537
RUNTIME_TOKEN_SECRET=local-runtime-change-this-146987ad64
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# Absolute HOST directory, mounted into manager at the identical absolute path.
# Linux default. Docker Desktop: set a writable shared absolute host path.
USER_DATA_ROOT=/data/cloud-work/users
# Optional local tag alias, refreshed automatically from each deployment. No version changes needed.
RUNTIME_IMAGE=cloud-work-runtime:latest
RUNTIME_CPUS=2
RUNTIME_MEMORY_MB=4096
RUNTIME_PIDS_LIMIT=256
RUNTIME_IDLE_MINUTES=30
RUNTIME_REMOVE_HOURS=24
RUNTIME_REAPER_INTERVAL_MS=60000

# Generate both once: openssl rand -hex 32 (separately for each).
# Retain/back up MCP_ENCRYPTION_KEY together with database backups.
MCP_GATEWAY_ADMIN_TOKEN=
MCP_ENCRYPTION_KEY=
# Exact origins; deny all until explicitly configured. No wildcard or URL path.
MCP_ALLOWED_ORIGINS=
# Optional exact private IPs for approved intranet MCP services, no CIDRs.
# Loopback, link-local and metadata addresses are always blocked.
MCP_ALLOWED_PRIVATE_IPS=

# Actual provider/model names in the pinned DSH version.
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
DSH_API_KEY=
# Custom gateway: set DSH_PROVIDER=openai-compatible or anthropic-compatible,
# DSH_MODEL to the gateway's exact model ID and DSH_BASE_URL to its root URL.
DSH_BASE_URL=
# Optional custom gateway model limits. Output tokens must not exceed context.
DSH_CONTEXT_WINDOW=
DSH_MAX_TOKENS=
